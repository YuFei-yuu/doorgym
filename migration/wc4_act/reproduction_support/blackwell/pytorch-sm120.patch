diff --git a/cmake/Modules_CUDA_fix/FindCUDNN.cmake b/cmake/Modules_CUDA_fix/FindCUDNN.cmake
index 8213432..d66fab2 100644
--- a/cmake/Modules_CUDA_fix/FindCUDNN.cmake
+++ b/cmake/Modules_CUDA_fix/FindCUDNN.cmake
@@ -41,6 +41,11 @@ if (CUDNN_LIBRARY MATCHES ".*cudnn_static.a" AND NOT CUDNN_STATIC)
   message(WARNING "CUDNN_LIBRARY points to a static library (${CUDNN_LIBRARY}) but CUDNN_STATIC is OFF.")
 endif()
 
+# Honor an explicit library file, including versioned pip cuDNN libraries.
+if(EXISTS "${CUDNN_LIBRARY}" AND NOT IS_DIRECTORY "${CUDNN_LIBRARY}")
+  set(CUDNN_LIBRARY_PATH "${CUDNN_LIBRARY}" CACHE FILEPATH "cuDNN library" FORCE)
+endif()
+
 find_library(CUDNN_LIBRARY_PATH ${CUDNN_LIBNAME}
   PATHS ${CUDNN_LIBRARY}
   PATH_SUFFIXES lib lib64 cuda/lib cuda/lib64 lib/x64)
